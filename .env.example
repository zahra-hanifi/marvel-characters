# Marvel API credentials — https://developer.marvel.com/account
# Copy to .env and fill in your own values. Never commit .env.

# Server-only. Used to sign requests in server/api/marvel/[...path].ts.
# Must never be exposed to the browser.
MARVEL_PRIVATE_KEY=your_marvel_private_key_here

# Sent to the Marvel API as the apikey parameter.
MARVEL_PUBLIC_KEY=your_marvel_public_key_here

# Upstream Marvel API base URL.
BASE_URL=https://gateway.marvel.com/v1/public
